<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_custom_dialog"
    android:orientation="vertical"
    android:padding="@dimen/margin_16dp">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAlertTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/medium"
        android:layout_marginTop="@dimen/margin_10dp"
        android:textFontWeight="600"
        android:text="Thông báo"
        android:textColor="@color/gray_1001"
        android:textSize="@dimen/textSize18" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvAlertContent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_16dp"
        android:layout_marginTop="@dimen/margin_10dp"
        android:gravity="center"
        android:layout_gravity="center"
        android:textColor="@color/gray_800"
        android:textSize="@dimen/textSize14"
        tools:text="Noi dung thong bao" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAlertConfirm"
        style="@style/button_orange_light_style"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_44dp"
        android:layout_marginTop="@dimen/margin_24dp"
        android:backgroundTint="#F58220"
        android:fontFamily="@font/medium"
        android:text="Thực hiện lại"
        android:textAllCaps="false"
        android:textSize="@dimen/textSize16" />


</androidx.appcompat.widget.LinearLayoutCompat>
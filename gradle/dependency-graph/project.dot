digraph {
  graph [label="Base_DN\n ",labelloc=t,fontsize=30,ranksep=1.4];
  node [style=filled, fillcolor="#bbbbbb"];
  rankdir=TB;

  # Projects

  ":app" [fillcolor="#baffc9"];
  ":library:choosePhotoHelper" [fillcolor="#baffc9"];
  ":library:spannedgridlayoutmanager" [fillcolor="#baffc9"];
  ":localization" [fillcolor="#baffc9"];
  ":ui" [fillcolor="#baffc9"];

  {rank = same;}

  # Dependencies

  ":app" -> ":app"
  ":app" -> ":ui" [style=dotted]
  ":app" -> ":localization" [style=dotted]
  ":localization" -> ":localization"
  ":ui" -> ":ui"
  ":ui" -> ":localization" [style=dotted]
  ":library:choosePhotoHelper" -> ":library:choosePhotoHelper"
  ":library:spannedgridlayoutmanager" -> ":library:spannedgridlayoutmanager"
}

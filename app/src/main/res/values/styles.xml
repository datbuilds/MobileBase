<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="navTextInactive">
        <item name="lineHeight">13sp</item>
        <item name="android:textSize">@dimen/textSize11</item>
        <item name="android:textColor">@color/colorTextTitle</item>
        <item name="android:tint">@color/colorTextTitle</item>
    </style>

    <style name="navTextActive">
        <item name="lineHeight">13sp</item>
        <item name="android:textSize">@dimen/textSize11</item>
        <item name="android:textColor">@color/colorTextTitle</item>
        <item name="android:tint">@color/colorTextTitle</item>
    </style>

    <style name="weekText" parent="Widget.AppCompat.TextView">
        <item name="fontFamily">@font/regular</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">#36434A</item>
    </style>

    <style name="ToolTipDialog" />

    <style name="ToolTipDialog.Text">
        <item name="android:textColor">?android:colorForeground</item>
    </style>

    <style name="SlideInCenterAnimation">
        <item name="android:windowEnterAnimation">@anim/slide_in_center</item>
    </style>

    <style name="tooltip_dialog_anaimation">
        <item name="android:windowEnterAnimation">@anim/fade_in_animate_up</item>
        <item name="android:windowExitAnimation">@android:anim/fade_out</item>
    </style>

    <style name="DialogAnimation" parent="android:Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="DialogAnimationTerm" parent="android:Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/bottom_in</item>
        <item name="android:windowExitAnimation">@anim/bottom_out</item>
    </style>

    <style name="base">
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">@font/regular</item>
    </style>

    <declare-styleable name="CustomProgressBar">
        <attr name="foreground_color" format="color" />
    </declare-styleable>

    <style name="custom.progressbar" parent="base">
        <item name="foreground_color">@color/colorAMCalendarDaySelectedCircle</item>
    </style>

    <style name="dialog_transparent_width" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
        <item name="android:windowMinWidthMajor">@dimen/margin_300dp</item>
        <item name="android:windowMinWidthMinor">@dimen/margin_300dp</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/white</item>
    </style>

    <style name="Widget.Theme.ToolTip.ActionBar.Fullscreen" parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black_overlay</item>
    </style>

    <style name="Widget.Theme.ToolTip.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>


    <style name="TooltipDialogTheme.Light" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="toolTipDialog.buttonVisibility">2</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="toolTipDialog.bodyTextStyle">@style/ToolTipDialog.Text.Body</item>
        <item name="toolTipDialog.backgroundColor">@color/white</item>
        <item name="toolTipDialog.buttonTextColor">@color/accent</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/use_light_status</item>
        <item name="android:statusBarColor">@color/statusBarColor</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">
            @bool/use_light_navigation
        </item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="TooltipDialogTheme.Dark" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="toolTipDialog.buttonVisibility">2</item>
        <!--        <item name="android:windowMinWidthMajor">100%</item>-->
        <!--        <item name="android:windowMinWidthMinor">100%</item>-->
        <item name="android:backgroundDimEnabled">false</item>
        <item name="toolTipDialog.bodyTextStyle">@style/ToolTipDialog.Text.Body.Dark</item>
        <item name="toolTipDialog.backgroundColor">@color/gray_800</item>
        <item name="toolTipDialog.buttonTextColor">@color/accent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/use_light_status</item>
        <item name="android:statusBarColor">@color/statusBarColor</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">
            @bool/use_light_navigation
        </item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="ToolTipDialog.Text.Body">
        <item name="android:textSize">17sp</item>
        <!--        <item name="android:lineSpacingExtra">4sp</item>-->
    </style>

    <style name="ToolTipDialog.Text.Body.Dark">
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="AMCalendarButtonStyle" parent="Widget.AppCompat.Button.Colored">
        <item name="android:colorButtonNormal">@color/colorAMCalendarShortcutElementBackground
        </item>
        <item name="android:textColor">@color/colorAMCalendarShortcutElementText</item>
    </style>

    <!-- res/values/styles.xml -->
    <style name="FeatureButtonStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">top|center</item>
        <item name="android:padding">@dimen/margin_5dp</item>
        <item name="android:drawablePadding">@dimen/margin_4dp</item>
        <item name="android:textColor">@color/colorText</item>
        <item name="android:textSize">@dimen/textSize13</item>
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/custom_ripple_borderless</item>
    </style>

    <style name="BottomNavTextActive" parent="@android:style/TextAppearance.Small">
        <item name="android:textSize">@dimen/textSize12</item>
        <item name="android:fontFamily">@font/medium</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="BottomNavTextInactive" parent="@android:style/TextAppearance.Small">
        <item name="android:textSize">@dimen/textSize12</item>
        <item name="android:textStyle">normal</item>
        <item name="android:fontFamily">@font/regular</item>
        <item name="android:letterSpacing">0.03</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="BottomNavigationViewStyle" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:background">@drawable/bottom_nav_background_with_shadow</item>
        <item name="itemIconSize">@dimen/margin_22dp</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="android:elevation">0dp</item>
        <item name="itemRippleColor">@color/Transparent</item>
    </style>

</resources>
<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/auth_flow_surface" />
            <stroke android:width="2dp" android:color="@color/auth_flow_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/auth_flow_surface" />
            <stroke android:width="1dp" android:color="@color/auth_flow_stroke" />
        </shape>
    </item>
</selector>

<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Trạng thái được chọn -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/margin_1000dp" />
            <gradient android:centerColor="#FF8D3C" android:endColor="#FF6B01" android:startColor="#FF842C" android:type="linear" />
        </shape>
    </item>

    <!-- Trạng thái bình thường -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/margin_1000dp" />

            <solid android:color="#E8E9EE" />
            <stroke android:width="1dp" android:color="#E8E9EE" />

        </shape>
    </item>
</selector>

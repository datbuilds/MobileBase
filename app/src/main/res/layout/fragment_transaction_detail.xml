<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_transaction_detail"
    android:orientation="vertical"
    android:paddingHorizontal="20dp">

    <FrameLayout
        android:id="@+id/flTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/paddingTopLayout"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivLogo"
            android:layout_width="@dimen/margin_140dp"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/logo_shb_success" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:padding="@dimen/margin_6dp"
            app:srcCompat="@drawable/ic_close" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llToastStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toast_change_avatar_ss"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/margin_8dp"
            android:paddingVertical="@dimen/margin_8dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="@+id/llBody"
            tools:visibility="gone">

            <com.mobile.base.base.view.MyTextView
                android:id="@+id/tvToastMessage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawableStart="@drawable/ic_success"
                android:drawablePadding="@dimen/margin_8dp"
                android:gravity="center_vertical"
                android:includeFontPadding="false"
                android:text="@string/successfullySetNickname"
                android:textColor="@color/white"
                android:textSize="@dimen/textSize14"
                app:customFontWeight="medium" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivCloseToast"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_6dp"
                android:padding="@dimen/margin_6dp"
                android:tint="@color/white"
                app:srcCompat="@drawable/ic_close" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/llBottom"
        app:layout_constraintTop_toBottomOf="@+id/flTop">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_24dp"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_success_transaction"
                tools:visibility="visible" />

            <com.mobile.base.base.view.MyTextView
                android:id="@+id/tvTransactionAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_12dp"
                android:text="@string/transactionAmount"
                android:textColor="@color/colorSuccess"
                android:textSize="@dimen/textSize18"
                android:visibility="gone"
                app:customFontWeight="medium"
                tools:visibility="visible" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/llValueBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/margin_8dp"
                android:gravity="top"
                android:orientation="horizontal">

                <com.mobile.base.base.view.MyTextView
                    android:id="@+id/tvValueBalance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="@dimen/textSize28"
                    app:customFontWeight="semi_bold"
                    tools:text="1,000,000" />

                <com.mobile.base.base.view.MyTextView
                    android:id="@+id/tvCurrentCode"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_gravity="top"
                    android:layout_marginStart="@dimen/margin_8dp"
                    android:textColor="@color/neutral7"
                    android:textSize="@dimen/textSize16"
                    app:customFontWeight="regular"
                    tools:text="LAK" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <com.mobile.base.base.view.MyTextView
                android:id="@+id/tvAnErrorHasOccurred"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/margin_10dp"
                android:gravity="center"
                android:text="@string/anErrorHasOccurred"
                android:textColor="@color/color_error_text_login"
                android:textSize="@dimen/textSize14"
                android:visibility="gone"
                app:customFontWeight="medium" />

            <include
                android:id="@+id/iclFromAccount"
                layout="@layout/child_view_transaction_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp" />

            <include
                android:id="@+id/iclToAccount"
                layout="@layout/child_view_transaction_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp" />

            <include
                android:id="@+id/iclAccountName"
                layout="@layout/child_view_transaction_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp" />

            <include
                android:id="@+id/iclRemarks"
                layout="@layout/child_view_transaction_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp" />

            <include
                android:id="@+id/iclTransactionDate"
                layout="@layout/child_view_transaction_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp" />

            <include
                android:id="@+id/iclReferenceNumber"
                layout="@layout/child_view_transaction_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp" />

            <include
                android:id="@+id/iclExchangeRate"
                layout="@layout/child_view_transaction_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_10dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <RelativeLayout
            android:id="@+id/rlSaveRecipient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="@dimen/margin_16dp"
            android:layout_marginTop="@dimen/margin_24dp"
            android:background="@drawable/bg_save_recipient"
            android:padding="@dimen/margin_12dp"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivBookmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                app:srcCompat="@drawable/ic_save_bene" />

            <com.mobile.base.base.view.MyTextView
                android:id="@+id/tvSaveRecipient"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/margin_12dp"
                android:layout_toEndOf="@+id/ivBookmark"
                android:text="@string/save_recipient"
                android:textColor="@color/neutral10"
                android:textSize="@dimen/textSize14"
                app:customFontWeight="regular" />

            <com.mobile.base.base.view.MyTextView
                android:id="@+id/tvSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="@string/save"
                android:textColor="@color/primary100"
                android:textSize="@dimen/textSize16"
                app:customFontWeight="regular" />

        </RelativeLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/margin_24dp"
            android:orientation="horizontal">

            <com.mobile.base.base.view.MyTextView
                android:id="@+id/tvCreateNewTransaction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginEnd="@dimen/margin_6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_new_transaction"
                android:gravity="center"
                android:paddingVertical="@dimen/margin_10dp"
                android:text="@string/createNewTransaction"
                android:textColor="@color/primary100"
                android:textSize="@dimen/textSize14"
                android:visibility="gone"
                app:customFontWeight="semi_bold"
                tools:visibility="visible" />

            <com.mobile.base.base.view.MyTextView
                android:id="@+id/tvShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/margin_6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_account_info_transfer"
                android:gravity="center"
                android:paddingVertical="@dimen/margin_10dp"
                android:text="@string/share"
                android:textColor="@color/neutral1"
                android:textSize="@dimen/textSize14"
                android:visibility="gone"
                app:customFontWeight="semi_bold"
                tools:visibility="visible" />
        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>

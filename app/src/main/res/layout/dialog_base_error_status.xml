<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bottomSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:orientation="vertical"
    android:paddingBottom="@dimen/margin_20dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivClose"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/margin_10dp"
        android:visibility="invisible"
        app:srcCompat="@drawable/ic_close" />

    <vn.shb.cam.base.view.MyTextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:drawableStart="@drawable/ic_bs_notification"
        android:drawablePadding="@dimen/margin_10dp"
        app:customFontWeight="medium"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_16dp"
        android:text="@string/title_noti"
        android:textColor="@color/gray_900"
        android:textSize="@dimen/textSize18" />

    <vn.shb.cam.base.view.MyTextView
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginHorizontal="@dimen/margin_16dp"
        android:layout_marginTop="@dimen/margin_20dp"
        app:customFontWeight="regular"
        android:gravity="start"
        android:textColor="#201D0F"
        android:textSize="@dimen/textSize16"
        tools:text="Vui lòng liên hệ tới bộ phận IT Support để được hỗ trợ cấp lại mật khẩu đăng nhập" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnClose"
        style="@style/button_orange_light_style"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_44dp"
        android:layout_marginHorizontal="@dimen/margin_16dp"
        android:layout_marginTop="@dimen/margin_20dp"
        android:text="@string/ui_common_close"
        android:textColor="@color/white"
        android:textSize="@dimen/textSize18" />
</androidx.appcompat.widget.LinearLayoutCompat>
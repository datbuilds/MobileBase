<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <vn.shb.lao.base.view.MyTextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/neutral8"
        android:textSize="@dimen/textSize14"
        app:customFontWeight="medium"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Title" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_6dp"
        android:background="@drawable/bg_child_view_transfer"
        android:paddingHorizontal="@dimen/margin_12dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle">

        <vn.shb.lao.base.view.MyEditText
            android:id="@+id/tvValue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="@dimen/margin_12dp"
            android:textColor="@color/neutral10"
            android:textColorHint="@color/neutral6"
            android:textSize="@dimen/textSize14"
            app:customFontWeight="medium"
            tools:hint="selected account" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivExpandDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:padding="@dimen/margin_4dp"
            android:tint="@color/black"
            app:srcCompat="@drawable/ic_arrow_down" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_marginVertical="@dimen/margin_12dp"
            android:background="@color/black" />

        <vn.shb.lao.base.view.MyTextView
            android:id="@+id/tvCurrentCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_12dp"
            android:textColor="@color/neutral8"
            android:textSize="@dimen/textSize14"
            app:customFontWeight="medium"
            tools:text="LAK" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.constraintlayout.widget.ConstraintLayout>
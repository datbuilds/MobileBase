<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/margin_16dp">

    <vn.shb.lao.base.view.MyTextView
        android:id="@+id/tvOrangeMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pleaseBringYourIdentity"
        android:textColor="@color/colorSubTextOrange"
        android:textSize="@dimen/textSize16"
        android:layout_marginEnd="8dp"
        app:customFontWeight="regular"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBranches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never"
        android:paddingVertical="@dimen/margin_8dp"
        android:scrollbars="vertical"
        app:layout_constraintHeight_max="@dimen/margin_450dp"
        app:layout_constraintTop_toBottomOf="@+id/tvOrangeMessage"
        tools:itemCount="6"
        tools:listitem="@layout/item_branch" />
</androidx.constraintlayout.widget.ConstraintLayout>

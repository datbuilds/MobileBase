<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/margin_16dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvOrangeMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/onest_regular"
        android:gravity="center"
        android:text="@string/pleaseBringYourIdentity"
        android:textColor="@color/colorSubTextOrange"
        android:textSize="@dimen/textSize14"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBranches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        app:layout_constraintHeight_max="@dimen/margin_300dp"
        app:layout_constraintTop_toBottomOf="@+id/tvOrangeMessage"
        tools:itemCount="6"
        tools:listitem="@layout/item_branch" />
</androidx.constraintlayout.widget.ConstraintLayout>

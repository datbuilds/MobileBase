<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/margin_16dp">

    <androidx.appcompat.widget.LinearLayoutCompat android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">

        <vn.shb.lao.base.view.MyTextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/set_nickname" android:textColor="@color/black" android:textSize="@dimen/textSize18" app:customFontWeight="semi_bold" />

        <androidx.appcompat.widget.AppCompatImageView android:id="@+id/ivClose" android:layout_width="wrap_content" android:layout_height="wrap_content" app:srcCompat="@drawable/ic_close" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_24dp" android:background="@drawable/bg_save_recipient" android:padding="@dimen/margin_12dp">

        <androidx.appcompat.widget.AppCompatImageView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_vertical" app:srcCompat="@drawable/ic_star" />

        <vn.shb.lao.base.view.MyTextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_12dp" android:text="@string/ask_set_nickname" android:textColor="@color/black" android:textSize="@dimen/textSize14" app:customFontWeight="regular" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <vn.shb.lao.base.view.MyEditText android:id="@+id/edtNickname" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_24dp" android:background="@drawable/bg_child_view_transfer" android:hint="@string/enter_nickname" android:padding="@dimen/margin_12dp" android:textSize="@dimen/textSize14" />

    <vn.shb.lao.base.view.MyTextView android:id="@+id/tvError" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_4dp" android:text="@string/error_enter_nickname" android:textColor="@color/color_error_text_login" android:visibility="gone" app:customFontWeight="regular" />

    <vn.shb.lao.base.view.MyTextView android:id="@+id/btnConfirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_24dp" android:background="@drawable/bg_button_disable" android:gravity="center" android:padding="@dimen/margin_12dp" android:text="@string/confirm" android:textColor="@color/white" android:textSize="@dimen/textSize16" app:customFontWeight="semi_bold" />

</androidx.appcompat.widget.LinearLayoutCompat>

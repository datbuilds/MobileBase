<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/margin_12dp"
    android:layout_marginVertical="@dimen/margin_6dp"
    tools:background="@drawable/bg_selected_account">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSelectAccount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_select_account_v" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvInfoAccount"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="@font/onest_regular"
        android:singleLine="true"
        android:textColor="@color/neutral10"
        android:textSize="@dimen/textSize14"
        app:layout_constraintEnd_toStartOf="@+id/ivSelectAccount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="1001747332 - Current Account - LAK" />

    <TextView
        android:id="@+id/tvValueBalance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_10dp"
        android:ellipsize="end"
        android:fontFamily="@font/onest_medium"
        android:singleLine="true"
        android:textColor="@color/neutral10"
        android:textSize="@dimen/textSize20"
        app:layout_constraintEnd_toStartOf="@+id/ivSelectAccount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvInfoAccount"
        tools:text="1001747332 - Current Account - LAK" />


</androidx.constraintlayout.widget.ConstraintLayout>
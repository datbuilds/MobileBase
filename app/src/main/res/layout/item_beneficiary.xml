<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="2dp"
    android:layout_marginVertical="@dimen/margin_2dp"
    card_view:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginVertical="@dimen/margin_14dp"
        android:paddingHorizontal="12dp">

        <FrameLayout
            android:layout_width="@dimen/margin_48dp"
            android:layout_height="@dimen/margin_48dp"
            android:layout_gravity="center"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_logo_app">

            <ImageView
                android:id="@+id/ivLogoBank"
                android:layout_width="@dimen/margin_28dp"
                android:layout_height="@dimen/margin_28dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_bank_acle" />

        </FrameLayout>

        <!-- Khối thông tin -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.mobile.base.base.view.MyTextView
                android:id="@+id/tvNameUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/neutral10"
                android:textSize="@dimen/textSize14"
                android:textAllCaps="true"
                card_view:customFontWeight="regular"
                tools:text="MS VATHANA SISANE" />

            <com.mobile.base.base.view.MyTextView
                android:id="@+id/tvNicknameUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/neutral10"
                android:textSize="@dimen/textSize14"
                card_view:customFontWeight="medium"
                tools:text="Nick name" />

            <com.mobile.base.base.view.MyTextView
                android:id="@+id/tvNumber"
                android:layout_width="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_height="wrap_content"
                android:textColor="@color/neutral10"
                android:textSize="@dimen/textSize16"
                card_view:customFontWeight="medium"
                tools:text="1001740559" />

            <com.mobile.base.base.view.MyTextView
                android:id="@+id/tvBank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/neutral10"
                android:textSize="@dimen/textSize12"
                card_view:customFontWeight="medium"
                tools:text="Saigon – Hanoi Commercial Joint Stock Bank" />
        </LinearLayout>

        <!-- Icon delete -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivDelete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_5dp"
            android:foreground="@drawable/ripple_grey_circle"
            android:src="@drawable/ic_delete"
            android:tint="@color/color_outcome" />

        <!-- Icon edit -->
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivEdit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/margin_5dp"
            android:foreground="@drawable/ripple_grey_circle"
            android:src="@drawable/ic_pen_edit"
            android:tint="#3F51B5" />

    </LinearLayout>

</androidx.cardview.widget.CardView>

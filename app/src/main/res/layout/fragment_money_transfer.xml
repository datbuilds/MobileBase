<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBgAccount">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llTop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/paddingTopLayout"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toTopOf="parent">

        <vn.shb.lao.base.view.MyTextView
            android:id="@+id/tvMoneyTransferTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/margin_20dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingVertical="@dimen/margin_8dp"
            android:paddingStart="@dimen/margin_4dp"
            android:paddingEnd="@dimen/margin_10dp"
            android:text="@string/moneyTransfer"
            android:textColor="@color/neutral10"
            android:textSize="@dimen/textSize20"
            app:customFontWeight="medium"
            app:drawableStartCompat="@drawable/ic_arrow_back" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/llTypeTransfer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_16dp"
            android:orientation="horizontal">

            <vn.shb.lao.base.view.MyTextView
                android:id="@+id/tvIntraBankTransfer"
                android:layout_width="@dimen/margin_0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/intrabankTransfer"
                android:textColor="@color/primary100"
                android:textSize="@dimen/textSize14"
                app:customFontWeight="medium"
                tools:background="@drawable/bg_transfer_normal" />

            <vn.shb.lao.base.view.MyTextView
                android:id="@+id/tvOwnAccountTransfer"
                android:layout_width="@dimen/margin_0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="@string/ownAccountTransfer"
                android:textColor="@color/primary100"
                android:textSize="@dimen/textSize14"
                app:customFontWeight="medium" />
        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clAccountInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_16dp"
            android:background="@drawable/bg_account_info_transfer"
            android:paddingHorizontal="@dimen/margin_16dp"
            android:paddingVertical="@dimen/margin_14dp">

            <vn.shb.lao.base.view.MyTextView
                android:id="@+id/tvCurrentAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/currentAccount"
                android:textColor="@color/neutral1"
                android:textSize="@dimen/textSize14"
                app:customFontWeight="regular"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <vn.shb.lao.base.view.MyTextView
                android:id="@+id/tvAccountNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_arrow_down"
                android:drawablePadding="8dp"
                android:paddingVertical="@dimen/margin_4dp"
                android:textColor="@color/neutral1"
                android:textSize="@dimen/textSize14"
                app:customFontWeight="medium"
                app:layout_constraintBottom_toBottomOf="@+id/tvCurrentAccount"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvCurrentAccount"
                tools:text="•••• 1234" />


            <vn.shb.lao.base.view.MyTextView
                android:id="@+id/tvBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_6dp"
                android:text="@string/currentBalance"
                android:textColor="@color/neutral1"
                android:textSize="@dimen/textSize14"
                app:customFontWeight="regular"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvCurrentAccount" />

            <vn.shb.lao.base.view.MyTextView
                android:id="@+id/tvBalanceValue"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:textColor="@color/neutral1"
                android:textSize="@dimen/textSize14"
                app:customFontWeight="medium"
                app:layout_constraintBottom_toBottomOf="@+id/tvBalance"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tvBalance"
                tools:text="18,617,662 LKKKK" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/vShadow"
        app:layout_constraintTop_toBottomOf="@+id/llTop">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:paddingHorizontal="@dimen/margin_20dp"
            android:layout_height="match_parent"
            android:paddingBottom="@dimen/margin_16dp"
            android:orientation="vertical">

            <include
                android:id="@+id/iclToAccount"
                layout="@layout/item_transfer_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp" />

            <include
                android:id="@+id/iclAccountName"
                layout="@layout/item_transfer_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp"
                android:visibility="gone" />

            <include
                android:id="@+id/iclAmount"
                layout="@layout/item_transfer_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp" />

            <include
                android:id="@+id/iclFee"
                layout="@layout/item_transfer_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp" />

            <include
                android:id="@+id/iclTotalAmount"
                layout="@layout/item_transfer_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp" />

            <include
                android:id="@+id/iclRemarks"
                layout="@layout/item_transfer_type"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp" />
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>

    <View
        android:id="@+id/vShadow"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_5dp"
        app:layout_constraintBottom_toTopOf="@+id/flAddNew"
        android:background="@drawable/bg_shadow_line"/>

    <FrameLayout
        android:id="@+id/flAddNew"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="0dp"
        app:cardBackgroundColor="#FAF6ED"
        app:cardElevation="@dimen/margin_8dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <vn.shb.lao.base.view.MyTextView
            android:id="@+id/tvTransferAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="@dimen/margin_16dp"
            android:layout_marginVertical="@dimen/paddingBottomLayout"
            android:background="@drawable/bg_account_info_transfer"
            android:gravity="center"
            android:paddingVertical="@dimen/margin_10dp"
            android:text="@string/transfer"
            android:textColor="@color/neutral1"
            android:textSize="@dimen/textSize14"
            app:customFontWeight="semi_bold" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
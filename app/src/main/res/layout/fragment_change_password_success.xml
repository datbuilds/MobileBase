<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_transaction_detail">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_16dp"
        android:layout_marginTop="@dimen/margin_16dp"
        app:cardCornerRadius="@dimen/margin_16dp"
        app:cardElevation="@dimen/margin_1dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/margin_12dp"
            android:paddingVertical="@dimen/margin_24dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivLogo"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:src="@drawable/logo_shb_saha"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSuccess"
                android:layout_width="@dimen/margin_34dp"
                android:layout_height="@dimen/margin_34dp"
                android:layout_marginTop="@dimen/margin_12dp"
                android:src="@drawable/ic_success"
                android:tint="@color/color_income"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ivLogo" />

            <vn.shb.lao.base.view.MyTextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12dp"
                android:text="@string/change_password_success"
                android:textColor="@color/color_income"
                android:textSize="@dimen/textSize14"
                app:customFontWeight="semi_bold"
                app:layout_constraintBottom_toBottomOf="@+id/ivSuccess"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivSuccess"
                app:layout_constraintTop_toTopOf="@+id/ivSuccess" />

            <View
                android:id="@+id/line"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/margin_24dp"
                android:background="#E0E0E0"
                app:layout_constraintTop_toBottomOf="@+id/ivSuccess" />

            <vn.shb.lao.base.view.MyTextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_16dp"
                android:text="@string/change_password_success_message"
                android:textColor="@color/gray_700"
                android:textSize="@dimen/textSize14"
                app:customFontWeight="regular"
                app:layout_constraintTop_toBottomOf="@+id/line" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <vn.shb.lao.base.view.MyTextView
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_16dp"
        android:layout_marginBottom="@dimen/margin_32dp"
        android:text="@string/login"
        android:paddingVertical="@dimen/margin_10dp"
        app:customFontWeight="semi_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:textSize="@dimen/textSize14"
        android:background="@drawable/bg_bt_share"
        android:textColor="@color/neutral1"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

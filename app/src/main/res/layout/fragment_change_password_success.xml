<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_login_long">

    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_16dp" app:cardCornerRadius="@dimen/margin_16dp" app:cardElevation="@dimen/margin_4dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/margin_24dp">

            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/ivLogo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:src="@drawable/logo_shb_saha" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />

            <androidx.appcompat.widget.AppCompatImageView android:id="@+id/ivSuccess" android:layout_width="@dimen/margin_32dp" android:layout_height="@dimen/margin_32dp" android:layout_marginTop="@dimen/margin_24dp" android:src="@drawable/ic_success" android:tint="@color/green_500" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@+id/ivLogo" />

            <vn.shb.lao.base.view.MyTextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/margin_12dp" android:text="@string/change_password_success" android:textColor="@color/green_500" android:textSize="@dimen/textSize16" app:customFontWeight="semi_bold" app:layout_constraintBottom_toBottomOf="@+id/ivSuccess" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintStart_toEndOf="@+id/ivSuccess" app:layout_constraintTop_toTopOf="@+id/ivSuccess" />

            <View android:id="@+id/line" android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="@dimen/margin_24dp" android:background="@color/gray_300" app:layout_constraintTop_toBottomOf="@+id/ivSuccess" />

            <vn.shb.lao.base.view.MyTextView android:id="@+id/tvMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/margin_16dp" android:text="@string/change_password_success_message" android:textColor="@color/gray_700" android:textSize="@dimen/textSize14" app:customFontWeight="regular" app:layout_constraintTop_toBottomOf="@+id/line" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <vn.shb.lao.base.view.MyTextView android:id="@+id/btnLogin" style="@style/button_orange_light_style" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/margin_16dp" android:layout_marginBottom="@dimen/margin_32dp" android:text="@string/login_action" app:customFontWeight="bold" app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

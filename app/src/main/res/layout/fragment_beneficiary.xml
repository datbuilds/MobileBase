<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="bottom"
    android:background="@color/bg_beneficiary"
    android:orientation="vertical"
    android:paddingTop="@dimen/paddingTopLayout"
    tools:context=".screens.beneficiary.BeneficiaryFragment">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/flAddNew"
        app:layout_constraintTop_toTopOf="parent">

        <vn.shb.lao.base.view.MyTextView
            android:id="@+id/tvMoneyTransferTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:drawablePadding="@dimen/margin_20dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingVertical="@dimen/margin_8dp"
            android:paddingStart="@dimen/margin_4dp"
            android:paddingEnd="@dimen/margin_10dp"
            android:text="@string/moneyTransfer"
            android:textColor="@color/neutral10"
            android:textSize="@dimen/textSize20"
            app:customFontWeight="medium"
            app:drawableStartCompat="@drawable/ic_arrow_back" />

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="@dimen/margin_16dp"
            android:background="@drawable/bg_search_beneficiary_w"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/margin_12dp"
            android:paddingVertical="@dimen/margin_14dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:srcCompat="@drawable/ic_search" />

            <vn.shb.lao.base.view.MyEditText
                android:id="@+id/edtSearchBeneficiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margin_12dp"
                android:hint="@string/enterRecipientName"
                android:includeFontPadding="false"
                android:textColor="@color/black"
                android:textColorHint="@color/neutral6"
                android:textSize="@dimen/textSize14" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcvBeneficiary"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/margin_12dp"
            tools:listitem="@layout/item_beneficiary" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llToastStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:background="@drawable/bg_toast_change_avatar_ss"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_8dp"
        android:visibility="gone"
        android:paddingVertical="@dimen/margin_8dp"
        app:layout_constraintTop_toTopOf="@+id/llBody">

        <vn.shb.lao.base.view.MyTextView
            android:id="@+id/tvToastMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_success"
            android:drawablePadding="@dimen/margin_8dp"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:textColor="@color/white"
            android:textSize="@dimen/textSize14"
            app:customFontWeight="medium"
            tools:text="@string/beneficiaryDeletedSuccessfully" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_6dp"
            android:padding="@dimen/margin_6dp"
            android:tint="@color/white"
            app:srcCompat="@drawable/ic_close" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <FrameLayout
        android:id="@+id/flAddNew"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/white"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <vn.shb.lao.base.view.MyTextView
            android:id="@+id/tvAddNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_20dp"
            android:layout_marginVertical="@dimen/paddingBottomLayout"
            android:background="@drawable/bg_button_action_material"
            android:gravity="center"
            android:textColor="@color/white"
            android:includeFontPadding="false"
            android:paddingVertical="@dimen/margin_12dp"
            android:text="@string/addNew" />

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4FAFF">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivImageLogin"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="375:260"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivImageLogin2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/bg_auth_light" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivAppLogo"
        android:layout_width="@dimen/margin_140dp"
        android:layout_height="@dimen/margin_36dp"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/paddingTopLayout"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_mobile_base" />

    <LinearLayout
        android:id="@+id/llLanguage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:background="@drawable/bg_layout_language"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/margin_12dp"
        android:paddingVertical="@dimen/margin_6dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivAppLogo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivAppLogo">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivLogoLanguage"
            android:layout_width="@dimen/widthLogoLanguage"
            android:layout_height="@dimen/widthLogoLanguage"
            android:layout_marginEnd="@dimen/margin_6dp"
            android:scaleType="centerInside"
            app:srcCompat="@drawable/ic_logo_uk" />

        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:srcCompat="@drawable/ic_arrow_down"
            app:tint="@color/auth_light_text" />
    </LinearLayout>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/llInfoUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@+id/ivImageLogin"
        tools:visibility="gone">

        <com.mobile.base.screens.home.widget.FrameAvatarUser
            android:id="@+id/flAvatarUser"
            android:layout_width="@dimen/margin_42dp"
            android:layout_height="@dimen/margin_42dp"
            tools:background="@color/blue" />

        <com.mobile.base.base.view.MyTextView
            android:id="@+id/tvHelloUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/margin_8dp"
            android:gravity="center"
            android:textColor="@color/auth_light_text"
            android:textSize="@dimen/textSize16"
            app:customFontWeight="regular"
            tools:text="name User" />


        <com.mobile.base.base.view.MyTextView
            android:id="@+id/tvNameUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textColor="@color/auth_light_text"
            android:textSize="@dimen/textSize16"
            app:customFontWeight="medium"
            tools:text=" PHASOUK BOUNMIXAY" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <com.mobile.base.base.view.MyTextView
        android:id="@+id/tvEnterYourDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:gravity="center"
        android:text="@string/enterYourDetailToSignIn"
        android:textColor="@color/auth_light_text"
        android:textSize="@dimen/textSize16"
        app:customFontWeight="regular"
        app:layout_constraintTop_toBottomOf="@+id/llInfoUser" />

    <LinearLayout
        android:id="@+id/userNameContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_24dp"
        android:background="@drawable/selector_edt"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvEnterYourDetail">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputUserNameLayout"
            style="@style/AppTextInputLayoutStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="@dimen/margin_8dp"
            app:layout_constraintTop_toBottomOf="@+id/tvEnterYourDetail">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtInputUsername"
                style="@style/AppTextInputEditTextStyle"
                android:textColor="@color/auth_light_text"
                android:textColorHint="@color/brand_input_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/enterYourUserName"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="10" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_clear_username"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:contentDescription="Clear username"
            android:src="@drawable/ic_clear_text"
            app:tint="@color/brand_input_hint"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <com.mobile.base.base.view.MyTextView
        android:id="@+id/tvErrorUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:text="@string/pleaseEnterUsername"
        android:textColor="@color/auth_light_error"
        android:textSize="@dimen/textSize12"
        android:visibility="gone"
        app:customFontWeight="medium"
        app:layout_constraintTop_toBottomOf="@+id/userNameContainer"
        tools:visibility="visible" />

    <LinearLayout
        android:id="@+id/passwordContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_24dp"
        android:background="@drawable/selector_edt"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@+id/tvErrorUsername">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/inputPasswordLayout"
            style="@style/AppTextInputLayoutStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingVertical="@dimen/margin_8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtInputPass"
                style="@style/AppTextInputEditTextStyle"
                android:textColor="@color/auth_light_text"
                android:textColorHint="@color/brand_input_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/enterPassword"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword"
                android:selectAllOnFocus="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_clear_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="8dp"
            android:contentDescription="Clear password"
            android:src="@drawable/ic_clear_text"
            app:tint="@color/brand_input_hint"
            android:visibility="gone"
            tools:visibility="visible" />

        <com.mobile.base.base.view.MyTextView
            android:id="@+id/btn_toggle"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:gravity="center_vertical"
            android:text="@string/hide"
            android:textColor="@color/auth_light_link"
            android:textSize="@dimen/textSize14"
            android:visibility="gone"
            app:customFontWeight="regular"
            tools:visibility="visible" />
    </LinearLayout>

    <com.mobile.base.base.view.MyTextView
        android:id="@+id/tvErrorPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_8dp"
        android:text="@string/pleaseEnterPassword"
        android:textColor="@color/auth_light_error"
        android:textSize="@dimen/textSize12"
        android:visibility="gone"
        app:customFontWeight="medium"
        app:layout_constraintTop_toBottomOf="@+id/passwordContainer"
        tools:visibility="visible" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        style="@style/button_login"
        android:layout_width="match_parent"
        android:layout_height="@dimen/margin_44dp"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:layout_marginTop="@dimen/margin_24dp"
        android:backgroundTint="@color/brand_light_action"
        android:textColor="@color/auth_light_text"
        android:text="@string/login"
        app:cornerRadius="@dimen/margin_12dp"
        app:layout_constraintTop_toBottomOf="@+id/tvErrorPassword" />

    <com.mobile.base.base.view.MyTextView
        android:id="@+id/tvHotline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/margin_20dp"
        android:layout_marginBottom="@dimen/margin_20dp"
        android:gravity="center"
        android:textColor="@color/auth_light_text"
        android:textSize="@dimen/textSize14"
        android:visibility="visible"
        app:customFontWeight="medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Hotline: +856.21.968.888 - +856.31.257.167" />

    <FrameLayout
        android:id="@+id/flRegisterDevice"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:layout_height="@dimen/margin_400dp"
        tools:visibility="gone" />

    <androidx.constraintlayout.widget.Group
        android:id="@+id/groupViewNoLastUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        tools:visibility="visible"
        app:constraint_referenced_ids="tvEnterYourDetail, userNameContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>
